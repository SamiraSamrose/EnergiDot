# .env.example
# Copy to .env and fill with your actual values

# ============================================
# SUBSTRATE NODE CONFIGURATION
# ============================================
NODE_ENV=development
CHAIN_SPEC=dev
RPC_PORT=9944
WS_PORT=9945
P2P_PORT=30333
VALIDATOR_MODE=false

# ============================================
# API GATEWAY CONFIGURATION
# ============================================
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://energidot:energidot_pass@localhost:5432/energidot
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRY=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# ============================================
# DATA AGGREGATOR CONFIGURATION
# ============================================
AGGREGATOR_PORT=3002

# NREL API (https://developer.nrel.gov/)
NREL_API_KEY=your-nrel-api-key-here
NREL_BASE_URL=https://developer.nrel.gov/api

# EIA API (https://www.eia.gov/opendata/)
EIA_API_KEY=your-eia-api-key-here
EIA_BASE_URL=https://api.eia.gov

# ENTSO-E API (https://transparency.entsoe.eu/)
ENTSOE_API_KEY=your-entsoe-api-key-here
ENTSOE_BASE_URL=https://transparency.entsoe.eu/api

# NOAA API (https://www.ncdc.noaa.gov/cdo-web/)
NOAA_API_KEY=your-noaa-api-key-here
NOAA_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2

# OpenWeatherMap API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-openweather-api-key-here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Copernicus CDS (requires separate registration)
COPERNICUS_API_KEY=your-copernicus-api-key-here
COPERNICUS_API_URL=your-copernicus-api-url-here

# Open Charge Map
OPEN_CHARGE_MAP_API_KEY=your-open-charge-map-key-here
OPEN_CHARGE_MAP_BASE_URL=https://api.openchargemap.io/v3

# Data Collection Intervals (in seconds)
SOLAR_DATA_INTERVAL=300
WIND_DATA_INTERVAL=300
GRID_DATA_INTERVAL=60
WEATHER_DATA_INTERVAL=600

# ============================================
# FRONTEND CONFIGURATION
# ============================================
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:9945
REACT_APP_CHAIN_NAME=EnergiDot
REACT_APP_NETWORK=development

# ============================================
# POLKADOT/SUBSTRATE CONFIGURATION
# ============================================
SUBSTRATE_RPC_URL=ws://localhost:9945
RELAY_CHAIN_RPC=wss://rococo-rpc.polkadot.io
PARA_ID=2000

# ============================================
# PHALA NETWORK (Privacy Layer)
# ============================================
PHALA_ENDPOINT=wss://poc5.phala.network/ws
PHALA_CONTRACT_ID=your-phala-contract-id

# ============================================
# IPFS/CRUST STORAGE
# ============================================
IPFS_GATEWAY=https://ipfs.io/ipfs/
CRUST_API_ENDPOINT=https://gw.crustapps.net

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-here
PROMETHEUS_PORT=9090

# ============================================
# PRODUCTION OVERRIDES (uncomment for prod)
# ============================================
# NODE_ENV=production
# API_HOST=0.0.0.0
# CORS_ORIGIN=https://energidot.io
# LOG_LEVEL=warn