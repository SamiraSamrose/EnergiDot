### Path: `.gitignore`

# Dependencies
node_modules/
target/
dist/
build/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.sql
*.db
*.sqlite

# Substrate
backend/substrate-node/target/
chain-spec*.json
genesis-state
genesis-wasm

# Docker
docker-compose.override.yml

# Build artifacts
*.wasm
*.wat

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Keys (NEVER commit these)
*.key
*.pem
keystore/

# Backup files
*.backup
*.bak
